import Snuffy.IR134SourceExtractedOutcome

/-! Ported from `evidence/physical-bridges/PhysicalBridges/IR135CommonPolicyWorlds.lean` at source commit `c8be1d9aa463592dd5525356fd35e2a9d690e24f` (sha256 `52821416a6e198a14a0ca1f973573a94c563dfee1e7c0284ece16a4c206177ce`). Imports and UPTExist references redirected to the canon; inline axiom-print commands moved to SummitsAudit. Statements and proofs unchanged. -/
set_option linter.unusedVariables false
set_option linter.unnecessarySimpa false
set_option linter.unusedSimpArgs false
/-
IR-135: Source-executed common-policy composition across action-reactive
worlds. Depends on draft IR-134, not existing manuscript/canon.

Crucial quantifier: ONE policy is selected before ANY admitted world.
Per-world maximality, physical continuity and all owed options then hold
for THAT policy in every world, provided strong uniform source and
profile premises. No universal physical installation / X3 inferred.
-/

namespace PhysicalBridges.IR135

universe u v w x y z
variable {S : Type u} {O : Type v} {A : Type w}
variable {D : Type x} {P : Type y} {W : Type z}

/-- The exact disturbance stream generated by an action-responsive
world in the same source dynamics. Disturbances are NOT selected
before the policy acts: they are computed stepwise from actual
state and action, with past history carried in the source state. -/
def reactiveDisturbances
    (next : S → A → D → S) (observe : S → O)
    (world : S → A → D) (policy : O → A) :
    S → Nat → List D
  | _, 0 => []
  | s, n + 1 =>
      let a := policy (observe s)
      let d := world s a
      d :: reactiveDisturbances next observe world policy
        (next s a d) n

/-- The previous IR-134 reactive history is not a fictional trace:
it is definitionally equivalent to executing the original source
against its OWN causally induced list of disturbances. -/
theorem reactive_trace_is_source_trace
    (next : S → A → D → S) (observe : S → O)
    (world : S → A → D) (policy : O → A)
    (s : S) (n : Nat) :
    IR134.runReactiveHistory next observe world policy s n =
      IR134.runHistory next observe policy s
        (reactiveDisturbances next observe world policy s n) := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
      change
        s :: IR134.runReactiveHistory next observe world policy
          (next s (policy (observe s)) (world s (policy (observe s)))) n =
        s :: IR134.runHistory next observe policy
          (next s (policy (observe s)) (world s (policy (observe s))))
          (reactiveDisturbances next observe world policy
            (next s (policy (observe s)) (world s (policy (observe s)))) n)
      exact congrArg (List.cons s)
        (ih (next s (policy (observe s)) (world s (policy (observe s)))))

/-- The same selected policy is used in every admitted world.
All four original UPT stages are kept, and ALL rival policies in
the SAME world are compared. No arbitrary 'realises' predicate.
The physical / identity conditions are explicit rather than smuggled
into a code or a chosen word for 'continues'.

This theorem states an implication, NOT the existence of such a
uniformly profile-certified policy or a comprehensive physical model.
-/
theorem same_policy_worldwise_original_maximality_and_continuation
    (next : S → A → D → S) (observe : S → O)
    (world : W → S → A → D) (initial : S)
    (policy : O → A) (horizon : Nat)
    (existingLife existingFreedom newLife newFreedom :
      List S → P → Prop)
    (owed : S → P → Prop) (continues : S → P → Prop)
    (required executable : S → P → A → Prop)
    (hMonotone : ∀ s d m,
      owed s m →
        owed (next s (policy (observe s)) d) m)
    (hRobust : ∀ s d,
      IR116.EveryOwedSubjectProtected owed continues required executable s →
      IR116.EveryOwedSubjectProtected owed continues required executable
        (next s (policy (observe s)) d))
    (hInitial : IR116.EveryOwedSubjectProtected
      owed continues required executable initial)
    (code : W → List S → Nat)
    (representative : W → Nat → List S)
    (profiles : W → List Nat)
    (hCoverage : ∀ ξ h,
      IR134.ExecutedInWorld next observe (world ξ) initial horizon h →
        code ξ h ∈ profiles ξ)
    (hFaithful : ∀ ξ h,
      IR134.ExecutedInWorld next observe (world ξ) initial horizon h →
      ∀ k, k ∈ IR134.fourOriginalKeys
        existingLife existingFreedom newLife newFreedom →
      ∀ p, k h p ↔ k (representative ξ (code ξ h)) p)
    (hObstructions : ∀ ξ c, c ∈ profiles ξ →
      IRProfileAudit.Obstructs
        (IR134.fourOriginalKeys
          existingLife existingFreedom newLife newFreedom)
        (IR134.runReactiveHistory next observe (world ξ) policy
          initial horizon)
        (representative ξ c)) :
    ∀ ξ : W,
      let selected :=
        IR134.runReactiveHistory next observe (world ξ) policy
          initial horizon
      IR134.ExecutedInWorld next observe (world ξ) initial horizon
        selected ∧
      Snuffy.Book.UPTExistence.LexAlignedL
        (IR134.ExecutedInWorld next observe (world ξ)
          initial horizon)
        (IR134.fourOriginalKeys
          existingLife existingFreedom newLife newFreedom)
        selected ∧
      (∀ m, owed initial m →
        ∀ state, state ∈ selected →
          continues state m ∧
          (∃ a, required state m a) ∧
          (∀ a, required state m a → executable state m a)) := by
  intro ξ
  have hOptimal :=
    IR134.reactive_world_original_order_selected_maximal
      next observe (world ξ) initial horizon policy
      existingLife existingFreedom newLife newFreedom
      (code ξ) (representative ξ) (profiles ξ)
      (hCoverage ξ) (hFaithful ξ) (hObstructions ξ)
  have hTrace :=
    reactive_trace_is_source_trace
      next observe (world ξ) policy initial horizon
  have hProtected :=
    IR134.original_cohort_continues_with_options_at_every_source_state
      next observe policy owed continues required executable
      hMonotone hRobust initial
      (reactiveDisturbances next observe (world ξ) policy initial horizon)
      hInitial
  refine ⟨hOptimal.1, hOptimal.2, ?_⟩
  intro m hm state hMember
  exact hProtected m hm state (by simpa only [hTrace] using hMember)

/-- Unlike the conditional same-policy maximality theorem above,
this actually DERIVES the existence of ONE observation-based policy
that preserves original-cohort duties across EVERY admitted reactive
world and EVERY finite horizon.

It reuses IR-113's exact observation-class action intersection, for
the physical-step relation generated by the SAME source dynamics.
The strong local source-law and genuine particularhood semantics
remain premises. The resulting policy may be noncomputable. Its
four-stage global MAXIMALITY remains a separate obligation.
-/
theorem observation_class_certificate_constructs_common_protection_policy
    (next : S → A → D → S) (observe : S → O)
    (owed : S → P → Prop) (continues : S → P → Prop)
    (required executable : S → P → A → Prop)
    (hDutyMonotone : ∀ s a d m,
      owed s m → owed (next s a d) m)
    (hCommon : ∀ o,
      ∃ a, IR113.ClassViableAction observe
        (IR134.PhysicalStep next)
        (IR116.EveryOwedSubjectProtected
          owed continues required executable) o a)
    (initial : S)
    (hInitial : IR116.EveryOwedSubjectProtected
      owed continues required executable initial) :
    ∃ policy : O → A,
      ∀ (world : S → A → D) (horizon : Nat)
        (m : P), owed initial m →
        ∀ state,
          state ∈ IR134.runReactiveHistory next observe world
            policy initial horizon →
          continues state m ∧
          (∃ a, required state m a) ∧
          (∀ a, required state m a → executable state m a) := by
  obtain ⟨policy, hClass⟩ :=
    (IR113.observation_policy_exists_iff_common_viable_action
      observe (IR134.PhysicalStep next)
      (IR116.EveryOwedSubjectProtected
        owed continues required executable)).mpr hCommon
  have hMonotone : ∀ s d m,
      owed s m → owed (next s (policy (observe s)) d) m := by
    intro s d m hm
    exact hDutyMonotone s (policy (observe s)) d m hm
  have hRobust : ∀ s d,
      IR116.EveryOwedSubjectProtected
        owed continues required executable s →
      IR116.EveryOwedSubjectProtected
        owed continues required executable
          (next s (policy (observe s)) d) := by
    intro s d hs
    exact hClass (observe s) s rfl hs
      (next s (policy (observe s)) d) ⟨d, rfl⟩
  refine ⟨policy, ?_⟩
  intro world horizon m hm state hMember
  have hTrace :=
    reactive_trace_is_source_trace
      next observe world policy initial horizon
  have hPath :=
    IR134.original_cohort_continues_with_options_at_every_source_state
      next observe policy owed continues required executable
      hMonotone hRobust initial
      (reactiveDisturbances next observe world policy initial horizon)
      hInitial
  exact hPath m hm state (by simpa only [hTrace] using hMember)

/-- A fully explicit hostile control: the same initial observation
admits two worlds requiring opposite first actions for the desired
outcome. Each world has an excellent controller if it could be picked
after the world was known. No single policy can do both. -/
def opposedStep (_ : Bool) (_ : Bool) (d : Bool) : Bool := d

def opposedWorld (ξ : Bool) (_ : Bool) (action : Bool) : Bool :=
  if ξ then action else !action

theorem each_reactive_world_has_its_own_successful_policy :
    ∀ ξ : Bool,
      ∃ policy : Unit → Bool,
        IR134.runReactiveHistory opposedStep
          (fun _ : Bool => ()) (opposedWorld ξ) policy false 1 =
          [false, true] := by
  intro ξ
  cases ξ with
  | false =>
      exact ⟨(fun _ => false), by decide⟩
  | true =>
      exact ⟨(fun _ => true), by decide⟩

theorem each_world_separate_success_does_not_yield_common_policy :
    ¬ ∃ policy : Unit → Bool,
      (∀ ξ : Bool,
        IR134.runReactiveHistory opposedStep
          (fun _ : Bool => ()) (opposedWorld ξ) policy false 1 =
          [false, true]) := by
  intro h
  obtain ⟨policy, hp⟩ := h
  cases ha : policy () with
  | false =>
      have hTrue := hp true
      simp [IR134.runReactiveHistory, opposedStep, opposedWorld, ha] at hTrue
  | true =>
      have hFalse := hp false
      simp [IR134.runReactiveHistory, opposedStep, opposedWorld, ha] at hFalse


end PhysicalBridges.IR135
